# Desenvolvimento
NEXO_DATA_DIR=data
# Render: papel restrito de PostgreSQL. Ausente para SQLite de desenvolvimento.
DATABASE_URL=
# Apenas manutenção local: proprietário/migração. NUNCA configurar no runtime.
DATABASE_MIGRATION_URL=
# Origem pública HTTPS, sem caminho/credenciais/query.
NEXO_APP_URL=
# Somente Vercel: origem HTTPS do Render. Ausente no Render.
NEXO_API_URL=
# Mesma chave privada nos dois serviços: 32 bytes aleatórios em hexadecimal.
NEXO_PROXY_SECRET=
# Produção: 0. 1 apenas nos servidores isolados de teste.
NEXO_TEST_MODE=0
NEXO_ALLOWED_HOSTS=
